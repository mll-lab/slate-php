{
    "name": "mll-lab/slate-php",
    "description": "PHP implementation of the [Slate Rich Text Editor](https://slatejs.org) data model",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Victor Stanciu",
            "email": "victor@prezly.com"
        },
        {
            "name": "Benedikt Franke",
            "email": "benedikt.franke@mll.com"
        }
    ],
    "require": {
        "php": "^7.4 || ^8",
        "ext-json": "*",
        "thecodingmachine/safe": "^1 || ^2"
    },
    "require-dev": {
        "dms/phpunit-arraysubset-asserts": "^0.3.0",
        "ergebnis/composer-normalize": "^2",
        "phpstan/phpstan": "^1",
        "phpunit/phpunit": "^9",
        "thecodingmachine/phpstan-safe-rule": "^1"
    },
    "autoload": {
        "psr-4": {
            "Prezly\\Slate\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Prezly\\Slate\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true
        }
    }
}
